# Copy this file to .env.local and fill in real values once you have them.

# Your production domain (used for SEO metadata, sitemap, and the QR code menu link)
NEXT_PUBLIC_SITE_URL=https://lobsterfactory.com

# Only needed when deploying as a GitHub Pages *project* site (e.g. shokeent.github.io/LobsterFactory).
# Leave unset for a custom domain, Vercel, or any host serving the site from the root.
# NEXT_PUBLIC_BASE_PATH=/LobsterFactory

# --- Optional, for future features ---
# Google Maps embed currently uses a keyless embed URL (see src/lib/site.ts).
# If you later want the full Maps JavaScript API (custom markers, directions, etc.):
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Instagram Graph API token, once you have an Instagram Business account connected:
# INSTAGRAM_ACCESS_TOKEN=

# Supabase project, if/when you add real reservations, loyalty accounts, or an order DB:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
